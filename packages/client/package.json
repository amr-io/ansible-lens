{
  "name": "ansible-lens",
  "displayName": "Ansible Lens",
  "description": "Zero-dependency, cross-platform, static-metadata Ansible Language Server & Linter. Ansible Lens is an independent, community-built extension and is not affiliated with or endorsed by Red Hat, Inc. Ansible® is a registered trademark of Red Hat, Inc.",
  "version": "0.1.0",
  "publisher": "amr-vibe",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/amr-vibe/ansible-lens.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "ansible",
    "yaml",
    "jinja2",
    "linter",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:ansible",
    "workspaceContains:ansible.cfg"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "configuration": {
      "title": "Ansible Lens",
      "properties": {
        "ansibleLens.documentLinks.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable clickable document links (underlines) on Ansible module names. Defaults to false so playbooks have zero permanent underlines; hover tooltips always include clickable official documentation links."
        }
      }
    },
    "commands": [
      {
        "command": "ansibleLens.openOfficialDocs",
        "title": "Ansible Lens: Open Official Docs"
      },
      {
        "command": "ansibleLens.refreshMetadata",
        "title": "Ansible Lens: Refresh Collection Metadata"
      },
      {
        "command": "ansibleLens.convertFileToFqcn",
        "title": "Ansible Lens: Convert File to FQCN"
      }
    ],
    "grammars": [
      {
        "scopeName": "text.jinja.ansible-lens.injection",
        "path": "./syntaxes/jinja2.injection.tmLanguage.json",
        "injectTo": [
          "source.yaml",
          "source.ansible"
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.json --noEmit",
    "package:vsix": "npm run build && npx @vscode/vsce package --no-dependencies -o ansible-lens-0.1.0.vsix"
  },
  "dependencies": {
    "@ansible-lens/core": "0.1.0",
    "@ansible-lens/server": "0.1.0",
    "vscode-languageclient": "^9.0.1"
  }
}
